# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ...but a demo corpus's captured tool output is fixture DATA, not a build
# artifact. The blanket `*.log` above silently kept every
# verification/fixtures/riscv_formal/*/sby.log out of the repo: developers
# had them on disk from the generator, so the suite was green locally while
# CI cloned a corpus with no logs in it and replayed empty text (every
# verdict NO_OUTCOME). Fixture corpora are committed; keep them committed.
!test/fixtures/**/*.log
!verification/fixtures/**/*.log

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Flutter gen-l10n output (regenerated on build)
lib/l10n/generated/
lib/generated/

# Riverpod / build_runner generated files (regenerated on build)
**/*.g.dart

# Per-project runtime artifacts (trends.db, regression-baseline.json)
# generated next to a project's simcrux.yaml. Must never be committed
# alongside fixture projects.
**/.simcrux/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Dart & Flutter DevTools local settings (per-developer, regenerated on demand)
devtools_options.yaml

# pubspec.lock IS tracked (2026-08-14). It was excluded as "path-dep version
# churn noise", and the cost of that showed up as CI going red on a commit that
# touched none of the affected code: CI resolves fresh every run, so
# `file_picker` publishing 12.0.0 broke the build while every local checkout
# kept passing from an older resolution. This is an application, not a library
# — the lock is the record of what was actually built and tested.

# Cloudflare Wrangler local cache (deploy_web.sh)
.wrangler/

# mkdocs build output. Generated by `mkdocs build` from docs-site/docs/; the
# published site is deployed from CI, never from a commit.
docs-site/site/

# Local environment files. None of these exist today, and none should: a
# public repo with outside contributors is where one gets committed by
# accident, and a secret in git history outlives its deletion.
.env
.env.*
!.env.example
# Two more spellings the `.env` rules above do not cover: Wrangler reads
# local secrets from `.dev.vars`, and direnv from `.envrc`. Both are files a
# contributor creates on their own machine, which is exactly how one gets
# committed.
.dev.vars
.dev.vars.*
.envrc
