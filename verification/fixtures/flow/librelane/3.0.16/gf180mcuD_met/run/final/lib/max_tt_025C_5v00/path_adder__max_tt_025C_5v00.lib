library (path_adder) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 5.00;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
  }

  cell ("path_adder") {
    area : 20152.016 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0371;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.72655");
	}
	cell_fall(scalar) {
          values("0.69872");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.74009");
	}
	cell_fall(scalar) {
          values("0.71366");
	}
      }
    }
    pin("d") {
      direction : input;
      capacitance : 0.0043;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.20398");
	}
	fall_constraint(scalar) {
          values("-0.26938");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.81926");
	}
	fall_constraint(scalar) {
          values("1.04081");
	}
      }
    }
    pin("q") {
      direction : output;
      capacitance : 0.0018;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
          values("6.06107,6.08064,6.14071,6.24478,6.40305,6.62505,6.91878,7.28877,7.74177,8.28077");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
          values("0.10969,0.13418,0.22000,0.38915,0.66467,1.05800,1.58245,2.23855,3.04245,4.00636");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
          values("6.24480,6.26813,6.33509,6.43409,6.56378,6.72478,6.92178,7.16078,7.44809,7.79009");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
          values("0.15754,0.18159,0.24922,0.35346,0.50613,0.71781,1.00132,1.37168,1.83300,2.39500");
	}
      }
    }
  }

}
