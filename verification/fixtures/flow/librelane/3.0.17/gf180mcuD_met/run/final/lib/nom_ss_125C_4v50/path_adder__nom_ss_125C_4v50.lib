library (path_adder) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 125.0;
  nom_voltage                    : 4.50;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00270,  0.00864,  0.02001,  0.03771,  0.06254,  0.09522,  0.13640,  0.18660,  0.24660");
  }

  cell ("path_adder") {
    area : 20152.016 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0357;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("1.27979");
	}
	cell_fall(scalar) {
          values("1.23752");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("1.29551");
	}
	cell_fall(scalar) {
          values("1.25516");
	}
      }
    }
    pin("d") {
      direction : input;
      capacitance : 0.0042;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.51967");
	}
	fall_constraint(scalar) {
          values("-0.64800");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.70781");
	}
	fall_constraint(scalar) {
          values("2.10208");
	}
      }
    }
    pin("q") {
      direction : output;
      capacitance : 0.0021;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00270,  0.00864,  0.02001,  0.03771,  0.06254,  0.09522,  0.13640,  0.18660,  0.24660");
          values("11.23393,11.26993,11.38093,11.56727,11.84427,12.22993,12.73693,13.37693,14.15893,15.09193");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00270,  0.00864,  0.02001,  0.03771,  0.06254,  0.09522,  0.13640,  0.18660,  0.24660");
          values("0.20247,0.24747,0.40240,0.69527,1.16933,1.85633,2.76800,3.91900,5.32534,6.99733");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00270,  0.00864,  0.02001,  0.03771,  0.06254,  0.09522,  0.13640,  0.18660,  0.24660");
          values("11.59703,11.64003,11.76303,11.94580,12.17904,12.46480,12.80803,13.21903,13.71004,14.28903");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00270,  0.00864,  0.02001,  0.03771,  0.06254,  0.09522,  0.13640,  0.18660,  0.24660");
          values("0.29045,0.33476,0.45530,0.64394,0.91339,1.27700,1.75848,2.38476,3.17300,4.13024");
	}
      }
    }
  }

}
