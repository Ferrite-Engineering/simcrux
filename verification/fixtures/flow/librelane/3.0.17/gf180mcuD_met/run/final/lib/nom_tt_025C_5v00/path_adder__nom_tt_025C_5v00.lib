library (path_adder) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 5.00;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
  }

  cell ("path_adder") {
    area : 20152.016 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0355;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.72071");
	}
	cell_fall(scalar) {
          values("0.69475");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.73119");
	}
	cell_fall(scalar) {
          values("0.70635");
	}
      }
    }
    pin("d") {
      direction : input;
      capacitance : 0.0042;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.21140");
	}
	fall_constraint(scalar) {
          values("-0.27687");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.82124");
	}
	fall_constraint(scalar) {
          values("1.04415");
	}
      }
    }
    pin("q") {
      direction : output;
      capacitance : 0.0021;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
          values("6.00564,6.02522,6.08529,6.18938,6.34761,6.56961,6.86338,7.23338,7.68638,8.22538");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
          values("0.10971,0.13422,0.22000,0.38915,0.66472,1.05800,1.58254,2.23846,3.04254,4.00662");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
          values("6.19973,6.22307,6.29004,6.38904,6.51869,6.67969,6.87669,7.11569,7.40304,7.74504");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
          values("0.15753,0.18161,0.24919,0.35347,0.50614,0.71779,1.00135,1.37165,1.83300,2.39500");
	}
      }
    }
  }

}
