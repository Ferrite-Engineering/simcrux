library (path_adder) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 5.00;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
  }

  cell ("path_adder") {
    area : 20152.016 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0365;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.72759");
	}
	cell_fall(scalar) {
          values("0.70087");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.73936");
	}
	cell_fall(scalar) {
          values("0.71391");
	}
      }
    }
    pin("d") {
      direction : input;
      capacitance : 0.0043;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.20544");
	}
	fall_constraint(scalar) {
          values("-0.27064");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.81878");
	}
	fall_constraint(scalar) {
          values("1.04024");
	}
      }
    }
    pin("q") {
      direction : output;
      capacitance : 0.0023;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
          values("6.04368,6.06325,6.12333,6.22739,6.38566,6.60766,6.90139,7.27139,7.72439,8.26339");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
          values("0.10969,0.13418,0.22000,0.38915,0.66468,1.05800,1.58246,2.23854,3.04246,4.00638");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
          values("6.22842,6.25175,6.31871,6.41772,6.54740,6.70840,6.90540,7.14440,7.43171,7.77371");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00264,  0.00841,  0.01943,  0.03660,  0.06069,  0.09238,  0.13230,  0.18110,  0.23920");
          values("0.15754,0.18159,0.24922,0.35346,0.50613,0.71781,1.00132,1.37168,1.83300,2.39500");
	}
      }
    }
  }

}
