library (path_adder) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 5.50;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00261,  0.00826,  0.01905,  0.03587,  0.05946,  0.09050,  0.12960,  0.17730,  0.23420");
  }

  cell ("path_adder") {
    area : 20152.016 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0346;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.46482");
	}
	cell_fall(scalar) {
          values("0.44423");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.47207");
	}
	cell_fall(scalar) {
          values("0.45205");
	}
      }
    }
    pin("d") {
      direction : input;
      capacitance : 0.0041;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.08823");
	}
	fall_constraint(scalar) {
          values("-0.12044");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.46064");
	}
	fall_constraint(scalar) {
          values("0.58918");
	}
      }
    }
    pin("q") {
      direction : output;
      capacitance : 0.0020;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00261,  0.00826,  0.01905,  0.03587,  0.05946,  0.09050,  0.12960,  0.17730,  0.23420");
          values("3.69990,3.71221,3.74999,3.81729,3.92139,4.06860,4.26372,4.50972,4.81172,5.17072");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00261,  0.00826,  0.01905,  0.03587,  0.05946,  0.09050,  0.12960,  0.17730,  0.23420");
          values("0.06801,0.08367,0.13822,0.25023,0.42988,0.68701,1.02784,1.45500,1.97892,2.60384");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00261,  0.00826,  0.01905,  0.03587,  0.05946,  0.09050,  0.12960,  0.17730,  0.23420");
          values("3.79410,3.80859,3.84959,3.91124,3.99184,4.09430,4.22194,4.37894,4.56994,4.79794");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00261,  0.00826,  0.01905,  0.03587,  0.05946,  0.09050,  0.12960,  0.17730,  0.23420");
          values("0.09523,0.11025,0.15269,0.21880,0.31730,0.45715,0.64691,0.89550,1.20548,1.57948");
	}
      }
    }
  }

}
