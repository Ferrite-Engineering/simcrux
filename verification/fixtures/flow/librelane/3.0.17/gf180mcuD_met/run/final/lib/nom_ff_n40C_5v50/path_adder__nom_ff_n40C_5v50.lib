library (path_adder) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 5.50;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00261,  0.00826,  0.01905,  0.03587,  0.05946,  0.09050,  0.12960,  0.17730,  0.23420");
  }

  cell ("path_adder") {
    area : 20152.016 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0355;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.46872");
	}
	cell_fall(scalar) {
          values("0.44750");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.47682");
	}
	cell_fall(scalar) {
          values("0.45624");
	}
      }
    }
    pin("d") {
      direction : input;
      capacitance : 0.0042;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.08479");
	}
	fall_constraint(scalar) {
          values("-0.11686");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.45902");
	}
	fall_constraint(scalar) {
          values("0.58683");
	}
      }
    }
    pin("q") {
      direction : output;
      capacitance : 0.0021;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00261,  0.00826,  0.01905,  0.03587,  0.05946,  0.09050,  0.12960,  0.17730,  0.23420");
          values("3.71671,3.72903,3.76680,3.83410,3.93820,4.08541,4.28055,4.52655,4.82855,5.18755");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00261,  0.00826,  0.01905,  0.03587,  0.05946,  0.09050,  0.12960,  0.17730,  0.23420");
          values("0.06800,0.08367,0.13822,0.25020,0.42987,0.68701,1.02777,1.45500,1.97889,2.60377");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00261,  0.00826,  0.01905,  0.03587,  0.05946,  0.09050,  0.12960,  0.17730,  0.23420");
          values("3.80959,3.82409,3.86509,3.92674,4.00734,4.10979,4.23744,4.39444,4.58544,4.81344");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00261,  0.00826,  0.01905,  0.03587,  0.05946,  0.09050,  0.12960,  0.17730,  0.23420");
          values("0.09522,0.11025,0.15268,0.21881,0.31729,0.45715,0.64692,0.89551,1.20546,1.57946");
	}
      }
    }
  }

}
