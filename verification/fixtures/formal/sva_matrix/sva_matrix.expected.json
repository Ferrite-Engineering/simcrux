    { "probe": "matrix2/m08_clocked_bool_past", "construct": "clocked $past(a) || !b", "form": "concurrent_boolean", "class": null, "cells": 1, "builtin": "refuse", "slang": "accept" },
    { "probe": "matrix2/m09_clocked_bool_rose", "construct": "clocked !$rose(a) || b", "form": "concurrent_boolean", "class": null, "cells": 1, "builtin": "refuse", "slang": "accept" },
